{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "react/no-unescaped-entities": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-explicit-any": "warn"
  },
  "overrides": [
    {
      "files": ["src/app/api/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/auth"],
                "message": "Use authServiceOrSession from @/lib/auth-service instead of auth() from @/auth in API routes. See STABILITY_ROADMAP_V2.md."
              },
              {
                "group": ["@/lib/auth"],
                "importNames": ["auth"],
                "message": "Use authServiceOrSession from @/lib/auth-service instead of auth() from @/lib/auth in API routes. See STABILITY_ROADMAP_V2.md."
              }
            ]
          }
        ]
      }
    }
  ]
}
